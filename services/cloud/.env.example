# LabHub Cloud（部署在你可控的服务器；切勿提交本文件）

PORT=8780
JWT_SECRET=请换成足够长的随机字符串
INVITE_CODE=labhub-invite
# 邀请码可选：用户不填也可注册；若填写则必须与 INVITE_CODE 一致
DEFAULT_PROJECT_LIMIT=3

# DeepSeek（仅 Cloud 持有）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 短信：开发默认 dev（控制台打印验证码，可用固定码）
SMS_PROVIDER=dev
SMS_DEV_CODE=123456

# 开发测试账号（SMS_PROVIDER=dev 时启动自动写入；控制台也会预填）
DEV_TEST_PHONE=13800138000
DEV_TEST_PASSWORD=labhub123
# SEED_DEV_USER=1

# 生产改为阿里云：
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
