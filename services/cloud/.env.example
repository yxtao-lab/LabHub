# LabHub Cloud（部署在你可控的服务器；切勿提交本文件）

PORT=8780
JWT_SECRET=请换成足够长的随机字符串
INVITE_CODE=labhub-invite
# 邀请码可选：用户不填也可注册；若填写则必须与 INVITE_CODE 一致（旧全局码已弃用，现为个人邀请码）
DEFAULT_PROJECT_LIMIT=3

# PostgreSQL（启动时自动建表）
# 本地可用：docker compose up -d（见 docker-compose.yml，端口 5433）
DATABASE_URL=postgresql://labhub:labhub@127.0.0.1:5433/labhub

# 支付：mock=系统内模拟支付即时开通；live=预留真实渠道
PAYMENT_MODE=mock

# DeepSeek（仅 Cloud 持有）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 短信：开发默认 dev（控制台打印验证码，可用固定码）
SMS_PROVIDER=dev
SMS_DEV_CODE=123456

# 开发测试账号（SMS_PROVIDER=dev 时启动自动写入；控制台也会预填）
DEV_TEST_PHONE=13800138000
DEV_TEST_PASSWORD=labhub123
# SEED_DEV_USER=1

# 生产改为阿里云：
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_REGION_ID=cn-hangzhou
